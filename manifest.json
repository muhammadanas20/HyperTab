{
  "manifest_version": 3,
  "name": "HyprTab — Animated Hyprland New Tab",
  "short_name": "HyprTab",
  "description": "Turns your new tab into a living Hyprland-style desktop: animated parallax wallpapers, glass widgets, and a web-slinging companion who roams the page.",
  "version": "1.0.0",
  "author": "HyprTab",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "HyprTab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "js/background.js",
    "type": "classic"
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["js/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": ["storage", "favicon", "contextMenus"],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*"
  ],
  "offline_enabled": true
}

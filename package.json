{
  "name": "hypertab",
  "version": "1.0.0",
  "description": "HyprTab — a Hyprland-inspired, animated new tab experience with a living web-slinger.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "zip": "node scripts/pack.mjs",
    "shots:setup": "npm i --no-save puppeteer @napi-rs/canvas",
    "rigshot": "node scripts/preview/rigshot.mjs",
    "rigshot:closeup": "node scripts/preview/rigshot.mjs .work/closeup.png closeup",
    "test": "node scripts/test.mjs",
    "preview": "node scripts/preview/serve.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
